{
  lib,
  buildNpmPackage,
  fetchFromGitHub,
  nodejs,
  makeWrapper,
}:

buildNpmPackage rec {
  pname = "multi-scrobbler";
  version = "0.13.3";

  src = fetchFromGitHub {
    owner = "FoxxMD";
    repo = "multi-scrobbler";
    rev = version;
    hash = "sha256-0YvtfzfuHBK6bhPQNLC44b6UpumRwkjmZj0B94dbqvM=";
  };

  # The upstream lockfile (generated by npm 11) omits `resolved` URLs for
  # transitive dependencies. Replace with a lockfile regenerated by npm 10
  # that includes all `resolved` and `integrity` fields.
  postPatch = ''
    cp ${./package-lock.json} package-lock.json
  '';

  npmDepsHash = "sha256-s+2HnX7rqo7vqLSOfJBOBmRtP3ck7mRK93bAPMLjFR0=";

  npmFlags = [ "--legacy-peer-deps" ];

  # Skip the default build which tries to build docs
  dontNpmBuild = true;

  nativeBuildInputs = [ makeWrapper ];

  buildPhase = ''
    runHook preBuild
    # Only build the frontend - backend runs via tsx
    npm run build:frontend
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out/{bin,lib/multi-scrobbler}
    cp -r src dist node_modules package.json tsconfig.json $out/lib/multi-scrobbler/

    # Create wrapper script using tsx to run TypeScript directly
    # Use --chdir to set working directory so tsconfig.json can be found
    makeWrapper ${nodejs}/bin/node $out/bin/multi-scrobbler \
      --add-flags "$out/lib/multi-scrobbler/node_modules/.bin/tsx" \
      --add-flags "$out/lib/multi-scrobbler/src/backend/index.ts" \
      --set NODE_ENV production \
      --chdir "$out/lib/multi-scrobbler"

    runHook postInstall
  '';

  meta = with lib; {
    description = "Scrobble plays from multiple sources to multiple clients";
    homepage = "https://github.com/FoxxMD/multi-scrobbler";
    license = licenses.mit;
    maintainers = [ ];
    mainProgram = "multi-scrobbler";
  };
}
